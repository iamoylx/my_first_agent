# ===== Python 编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ===== 本地记忆与运行时产物（不进仓库） =====
# .workbuddy 是 WorkBuddy 的项目记忆/配置，含本地约定，不公开
.workbuddy/
# 会话持久化是运行时生成的，重启即重新落盘，无需版本管理
memory/sessions/
# 编辑器/系统
.vscode/
.DS_Store
Thumbs.db

# ===== 密钥 / 环境变量（绝不提交） =====
.env
.env.*
*.local

# ===== 日志 / 临时 =====
*.log
tmp/
