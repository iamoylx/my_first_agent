# ===== Python 编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ===== 本地记忆数据（硬盘，不进仓库） =====
# memory/ 是机制代码（进仓库）；memory_data/ 是本地记忆数据，可整体提取、不公开
memory_data/
# 旧扁平路径防御性忽略（数据已迁至 memory_data/，防止以后误在 memory/ 下生成）
memory/sessions/
memory/users/
memory/profile.json
# 记忆备份（分离操作前的人工备份，不进仓库）
memory.bak.*/
# 女儿技能遗留笔记数据（本地记忆，不进仓库）
skills/memory/
# .workbuddy 是 WorkBuddy 的项目记忆/配置，含本地约定，不公开
.workbuddy/
# 编辑器/系统
.vscode/
.DS_Store
Thumbs.db

# ===== 密钥 / 环境变量（绝不提交） =====
.env
.env.*
*.local

# ===== 日志 / 临时 =====
*.log
tmp/

# ===== 测试脚本（不进仓库；本地用 temp 目录隔离，不污染 memory） =====
tests/

# ===== PyInstaller 构建产物（不进仓库） =====
build/
dist/
*.spec
pet_icon.ico

# ===== 隔离/待删暂存（清理时 mv 进来的垃圾，可逆，不进仓库） =====
_trash/

# ===== 桌宠阶段遗留素材（终端版不加载，保留备用，不进仓库） =====
素材/

# ===== Tauri 桌面客户端构建产物（不进仓库） =====
desktop-client/src-tauri/target/
desktop-client/node_modules/
desktop-client/dist/

# ===== 根目录构建产物（发行用，不入库）=====
/agent-desktop.exe
/WebView2Loader.dll
/agent-idle.ico

# ===== 桌宠构建垃圾 / 截图 / 日志（不入库）=====
desktop-client/_target_fresh/
desktop-client/_shot.png
desktop-client/*.log
desktop-client/boot.txt
desktop-client/webview2_diag.txt

# ===== 思考轨迹黑匣子日志（运行时产物，不入库）=====
logs/

