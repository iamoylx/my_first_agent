# ===== Python 编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ===== 本地记忆与运行时产物（不进仓库） =====
# .workbuddy 是 WorkBuddy 的项目记忆/配置，含本地约定，不公开
.workbuddy/
# 会话持久化是运行时生成的，重启即重新落盘，无需版本管理
memory/sessions/
# 统一记忆层按用户隔离的目录（memory/users/<id>/），含本地记忆，不进仓库
memory/users/
# 长期档案卡（扁平旧路径，兼容回退用）：本地存储的用户事实，不公开、不预设
memory/profile.json
# 编辑器/系统
.vscode/
.DS_Store
Thumbs.db

# ===== 密钥 / 环境变量（绝不提交） =====
.env
.env.*
*.local

# ===== 日志 / 临时 =====
*.log
tmp/

# ===== 测试脚本（不进仓库；本地用 temp 目录隔离，不污染 memory） =====
tests/
